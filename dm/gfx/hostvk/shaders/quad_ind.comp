// Indirect quads (docs/design/vulkan-backend.md 2.7, 4.8; step P8; vk_commands.c quads_ind_gpu): Vulkan has no quads, and the record of an indirect quad draw is often written by the
// GPU earlier in the submission (Hyrule Warriors: Age of Calamity's GPU-driven effects), so it is converted on the GPU, in order, as the Metal backend's ixc_run does.
// Mode 0, arrays: the record {count, instances, first, base instance} becomes an indexed one {index count, instances, first index 0, vertex offset first, base instance} over the
// backend's shared quad list (0 1 2) (0 2 3) per quad, at most cap indices. Mode 1, elements: the record {count, instances, first index, base vertex, base instance} becomes
// {index count, instances, 0, base vertex, base instance} over a 32-bit list of at most cap indices expanded from the game's (one thread per index); an index past the readable
// bytes of the index buffer (ilen from ib) reads 0. Push constants: the record, the indexed record written, the list written, the index buffer (aligned down to 4 bytes, shift
// the byte offset there), the index size, the cap, the mode
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) buffer W { uint v[]; };
layout(push_constant) uniform P { uvec2 rec, args, outp, ib; uint shift, isz, cap, mode, ilen; } p;
uint fetch(uint i) {
    uint byte = p.shift + i * p.isz;
    if (byte + p.isz > p.ilen) return 0u;
    uint w = W(p.ib).v[byte >> 2], s = (byte & 3u) * 8u;
    return p.isz == 4u ? w : p.isz == 2u ? (w >> s) & 0xffffu : (w >> s) & 0xffu;
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (p.mode == 0u) {
        if (i != 0u) return;
        uint n = W(p.rec).v[0];
        W(p.args).v[0] = min(n / 4u * 6u, p.cap); W(p.args).v[1] = W(p.rec).v[1]; W(p.args).v[2] = 0u; W(p.args).v[3] = W(p.rec).v[2]; W(p.args).v[4] = W(p.rec).v[3];
        return;
    }
    uint n = W(p.rec).v[0], m = min(n / 4u * 6u, p.cap);
    if (i == 0u) { W(p.args).v[0] = m; W(p.args).v[1] = W(p.rec).v[1]; W(p.args).v[2] = 0u; W(p.args).v[3] = W(p.rec).v[3]; W(p.args).v[4] = W(p.rec).v[4]; }
    if (i >= m) return;
    uint t = i / 6u, c = i % 6u, k = c == 0u || c == 3u ? 0u : c == 1u ? 1u : c == 2u || c == 4u ? 2u : 3u;   // (0 1 2) (0 2 3) of quad t
    W(p.outp).v[i] = fetch(W(p.rec).v[2] + 4u * t + k);
}
