// FSR 1's second pass at present (docs/design/vulkan-backend.md 7.4, decision D4; vk_present.c, DM_PRESENT_UPSCALE=fsr): RCAS, AMD FidelityFX Super Resolution 1.0's robust
// contrast-adaptive sharpening, from the EASU image (read texel by texel, the coordinates clamped to its edges: RCAS reads a cross of five texels) into the picture's rectangle.
// The 32-bit path of the unmodified dm/third_party/fsr1 headers, with the load callback they ask for and no input conversion (UNORM in, UNORM out: the picture's gamma space).
// Push constants: out_size = the rectangle's size (the EASU image's), off = its origin in the target; sharpness = FsrRcasCon's argument, in stops (0 the sharpest RCAS gives,
// each whole stop halves the sharpening; DM_PRESENT_SHARPEN). in_size and flip belong to fsr_easu.comp.
// KIND 0 writes an R8G8B8A8_UNORM target (the format qualifier rgba8: the second intermediate image, or a swapchain image in that format); KIND 1 writes any format (no qualifier:
// a B8G8R8A8 or 10-bit swapchain image, on a device with shaderStorageImageWriteWithoutFormat). gen_spirv.sh compiles it for KIND 0-1 (fsr_rcas_comp.h)
#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform sampler2D src;
#if KIND == 0
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;
#else
layout(set = 0, binding = 1) uniform writeonly image2D dst;
#endif
layout(push_constant) uniform P { ivec2 in_size, out_size, off; int flip; float sharpness; } p;
#define A_GPU 1
#define A_GLSL 1
#include "../../../third_party/fsr1/ffx_a.h"
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 q) { return texelFetch(src, clamp(q, ASU2(0), p.out_size - 1), 0); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "../../../third_party/fsr1/ffx_fsr1.h"
void filter_at(AU2 ip, AU4 con) {
    if (ip.x >= uint(p.out_size.x) || ip.y >= uint(p.out_size.y)) return;
    AF3 c;
    FsrRcasF(c.r, c.g, c.b, ip, con);
    imageStore(dst, ASU2(ip) + p.off, AF4(c, 1.0));
}
void main() {
    AU4 con;
    FsrRcasCon(con, p.sharpness);
    AU2 gxy = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    filter_at(gxy, con);
    gxy.x += 8u;
    filter_at(gxy, con);
    gxy.y += 8u;
    filter_at(gxy, con);
    gxy.x -= 8u;
    filter_at(gxy, con);
}
